<Window x:Class="Glance.App.Views.CalibrationTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#FF101418"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Title="Glance calibration target">
    <Grid>
        <Canvas x:Name="TargetCanvas">
            <Ellipse x:Name="TargetDot" Width="72" Height="72" Fill="#FFF4F7FB" />
        </Canvas>
        <Border x:Name="InstructionCard" Background="#CC101418" CornerRadius="12" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" MaxWidth="560">
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="#FFF4F7FB" FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock x:Name="InstructionText"
                           Text="Look at the dot and hold still. This screen position is not a gaze angle."
                           Foreground="#FFD0D7E2" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" Margin="0,8,0,0" />
                <TextBlock x:Name="ProgressText" Text="0 / 8"
                           Foreground="#FFF4F7FB" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <ui:Button x:Name="ConfirmButton" Content="Use these samples" Appearance="Primary" Click="OnConfirm" Margin="0,0,8,0" IsEnabled="False" />
                    <ui:Button Content="Close" Appearance="Secondary" Click="OnClose" />
                </StackPanel>
                <TextBlock Text="Escape closes this target and does not save the profile."
                           Foreground="#FFD0D7E2" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
