<Window x:Class="Glance.App.Views.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="1"
        Height="1"
        Left="-32000"
        Top="-32000"
        Opacity="0"
        AllowsTransparency="True"
        Background="Transparent"
        Title="Glance tray">
    <tb:TaskbarIcon x:Name="TrayIcon"
                    ToolTipText="{Binding ToolTip}"
                    IconSource="pack://application:,,,/Assets/glance.png"
                    LeftClickCommand="{Binding ShowDashboardCommand}">
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open Glance" Command="{Binding ShowDashboardCommand}" />
                <MenuItem Header="Enable eye tracking" IsCheckable="True" IsChecked="{Binding TrackingEnabled}" />
                <Separator />
                <MenuItem Header="Calibrate" Command="{Binding ShowCalibrationCommand}" />
                <MenuItem Header="Settings" Command="{Binding ShowSettingsCommand}" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
</Window>
