<ui:FluentWindow x:Class="Glance.App.Views.LandmarkPreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Landmark preview"
                 Width="980"
                 Height="760"
                 MinWidth="720"
                 MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Landmark preview" Grid.Row="0" />
        <Border Grid.Row="1" Background="#FF101418" CornerRadius="8" Margin="0,0,0,12">
            <Image x:Name="FrameImage" Stretch="Uniform" StretchDirection="Both" />
        </Border>
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Opening the landmark preview." />
            <TextBlock Style="{StaticResource SubtleText}" Margin="0,6,0,0"
                       Text="The picture keeps the captured aspect ratio. It is fitted inside the window, not stretched to fill it. Eye arrows end on the iris landmark. The pale arrow from the nose is head direction and is not used to choose a monitor. Extra boxes stay visible and are not measured. This window does not move the cursor." />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
